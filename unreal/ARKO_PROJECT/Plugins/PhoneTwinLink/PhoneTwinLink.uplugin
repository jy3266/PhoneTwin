		{ "Name": "PhoneTwinLink", "Type": "Runtime", "LoadingPhase": "Default" },
		{ "Name": "PhoneTwinLinkEditor", "Type": "Editor", "LoadingPhase": "PostEngineInit" }
	],
	"Plugins": [
		{ "Name": "LidarPointCloud", "Enabled": true }
	]
}
